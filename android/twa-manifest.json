{
  "packageId": "com.shamimnoor.muhasabahpro",
  "host": "muhasabah-pro.netlify.app",
  "name": "Muhasabah Pro",
  "launcherName": "Muhasabah",
  "display": "standalone",
  "orientation": "portrait",
  "themeColor": "#0a0d14",
  "themeColorDark": "#0a0d14",
  "navigationColor": "#0a0d14",
  "navigationColorDark": "#0a0d14",
  "navigationDividerColor": "#0a0d14",
  "navigationDividerColorDark": "#0a0d14",
  "backgroundColor": "#0a0d14",
  "enableNotifications": true,
  "startUrl": "/?source=twa",
  "iconUrl": "https://muhasabah-pro.netlify.app/icons/icon-512.png",
  "maskableIconUrl": "https://muhasabah-pro.netlify.app/icons/maskable-512.png",
  "splashScreenFadeOutDuration": 300,
  "signingKey": {
    "path": "./android.keystore",
    "alias": "muhasabah"
  },
  "appVersionName": "2.1.0",
  "appVersionCode": 3,
  "shortcuts": [
    {
      "name": "Prayer hub",
      "shortName": "Prayer",
      "url": "/?open=prayer&source=shortcut",
      "chosenIconUrl": "https://muhasabah-pro.netlify.app/icons/shortcut.png"
    },
    {
      "name": "Quran",
      "shortName": "Quran",
      "url": "/?open=quran&source=shortcut",
      "chosenIconUrl": "https://muhasabah-pro.netlify.app/icons/shortcut.png"
    },
    {
      "name": "Reminder feed",
      "shortName": "Reminder",
      "url": "/?open=reminder&source=shortcut",
      "chosenIconUrl": "https://muhasabah-pro.netlify.app/icons/shortcut.png"
    },
    {
      "name": "Zikr counter",
      "shortName": "Zikr",
      "url": "/?open=zikr&source=shortcut",
      "chosenIconUrl": "https://muhasabah-pro.netlify.app/icons/shortcut.png"
    }
  ],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://muhasabah-pro.netlify.app/manifest.webmanifest",
  "fallbackType": "customtabs",
  "features": {
    "locationDelegation": {
      "enabled": true
    }
  },
  "alphaDependencies": {
    "enabled": false
  },
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "minSdkVersion": 24,
  "fullScopeUrl": "https://muhasabah-pro.netlify.app/",
  "shareTarget": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "backup",
          "accept": [
            "application/json",
            ".json",
            "text/plain",
            ".txt"
          ]
        }
      ]
    }
  }
}
