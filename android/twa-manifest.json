{
  "packageId": "com.shamimnoor.muhasabahpro",
  "host": "muhasabah-pro.app",
  "name": "Muhasabah — Habit Tracker",
  "launcherName": "Muhasabah",
  "display": "standalone",
  "orientation": "portrait",
  "themeColor": "#0a0d14",
  "themeColorDark": "#0a0d14",
  "navigationColor": "#0a0d14",
  "navigationColorDark": "#0a0d14",
  "navigationDividerColor": "#0a0d14",
  "navigationDividerColorDark": "#0a0d14",
  "backgroundColor": "#0a0d14",
  "enableNotifications": true,
  "startUrl": "/?source=twa",
  "iconUrl": "https://muhasabah-pro.app/icons/icon-512.png",
  "maskableIconUrl": "https://muhasabah-pro.app/icons/maskable-512.png",
  "splashScreenFadeOutDuration": 300,
  "signingKey": {
    "path": "./android.keystore",
    "alias": "muhasabah"
  },
  "appVersionName": "1.4.0",
  "appVersionCode": 1,
  "shortcuts": [
    {
      "name": "Quick check-in",
      "shortName": "Check-in",
      "url": "/widgets/?view=habits&source=shortcut",
      "chosenIconUrl": "https://muhasabah-pro.app/icons/shortcut.png"
    },
    {
      "name": "Quick to-do",
      "shortName": "To-Do",
      "url": "/widgets/?view=todo&add=1&source=shortcut",
      "chosenIconUrl": "https://muhasabah-pro.app/icons/shortcut.png"
    },
    {
      "name": "Zikr counter",
      "shortName": "Zikr",
      "url": "/?open=zikr&source=shortcut",
      "chosenIconUrl": "https://muhasabah-pro.app/icons/shortcut.png"
    },
    {
      "name": "New note",
      "shortName": "Note",
      "url": "/?open=notes&source=shortcut",
      "chosenIconUrl": "https://muhasabah-pro.app/icons/shortcut.png"
    }
  ],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://muhasabah-pro.app/manifest.webmanifest",
  "fallbackType": "customtabs",
  "features": {},
  "alphaDependencies": {
    "enabled": false
  },
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "minSdkVersion": 24
}
