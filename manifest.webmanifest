{
  "id": "/",
  "name": "Muhasabah: Islamic Lifestyle",
  "short_name": "Muhasabah",
  "description": "Muhasabah: Islamic Lifestyle. Your whole Muslim day in one app: a personal Reminder feed (Quran, Hadith, Hikmah, Duas and Seerah — you choose the mix), prayer times with live countdowns (Sehri, Iftar, Tahajjud, Ishraq, forbidden times), Qibla compass, nearby mosques, essential daily amol, the Quran with full-text search, Hadith, the Seerah, Masnun duas and the 99 Names of Allah, habits, to-dos, Keep-style notes, a ledger (hisab khata), zikr counter, a private diary, bookmarks across every app and home-screen widgets — with a 360° Nafs · Qalb · Ruh analytics dashboard. Free, works offline, data stays on your device. No ads.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "tab_strip": {
    "home_tab": {
      "scope_patterns": [
        {
          "pathname": "/"
        }
      ],
      "icons": [
        {
          "src": "/icons/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    "new_tab_button": {
      "url": "/?source=tabbed-new-tab"
    }
  },
  "orientation": "portrait",
  "background_color": "#0a0d14",
  "theme_color": "#0a0d14",
  "categories": [
    "lifestyle",
    "productivity",
    "education"
  ],
  "icons": [
    {
      "src": "/icons/icon-48.png",
      "sizes": "48x48",
