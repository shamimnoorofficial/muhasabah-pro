  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.shamimnoor.muhasabahpro",
      "id": "com.shamimnoor.muhasabahpro"
    },
    {
      "platform": "webapp",
      "url": "https://muhasabah-pro.app/manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "backup",
          "accept": [
            "application/json",
            ".json",
            "text/plain",
            ".txt"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/?source=file",
      "accept": {
        "application/json": [
          ".json"
        ],
        "text/plain": [
          ".txt"
        ]
      },
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+muhasabah",
      "url": "/?protocol=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 420
  },
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "note_taking": {
    "new_note_url": "/?source=note"
  },
  "scope_extensions": [
    {
      "type": "origin",
      "origin": "https://muhasabah-pro.netlify.app"
    }
  ],
  "widgets": [
    {
      "name": "Muhasabah — Today",
      "short_name": "Today",
      "description": "Today's habit progress, point balance and the next habit due.",
      "tag": "mhs-today",
      "template": "mhs-today",
      "ms_ac_template": "/widgets/today-template.json",
      "data": "/widgets/today-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/assets/screenshots/04-widget.webp",
          "sizes": "1080x1920",
          "label": "Configurable home-screen widget with prayer countdowns and amol check-ins"
        }
      ],
      "icons": [
        {
          "src": "/icons/icon-96.png",
          "sizes": "96x96"
        }
      ],
      "auth": false,
      "update": 3600
    }
  ]
}
