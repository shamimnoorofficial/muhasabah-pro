      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/promo/01-home-overview.webp",
      "sizes": "1080x1920",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Your whole life, one honest audit — Nafs · Qalb · Ruh scorecard and the Muhasabah Index"
    },
    {
      "src": "/screenshots/promo/02-home-checklist.webp",
      "sizes": "1080x1920",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Tick habits & to-dos right from Home — Circular check-ins that update instantly"
    },
    {
      "src": "/screenshots/promo/03-home-dashboard.webp",
      "sizes": "1080x1920",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Points, streaks & progress — Make habit, get reward"
    },
    {
      "src": "/screenshots/promo/04-todo.webp",
      "sizes": "1080x1920",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "A To Do list that respects your time — Deadlines, points and quick add"
    },
    {
      "src": "/screenshots/promo/05-habits.webp",
      "sizes": "1080x1920",
