{
  "id": "/",
  "name": "Muhasabah Pro",
  "short_name": "Muhasabah",
  "description": "Muhasabah Pro is an Islamic life super-app: prayer times with live countdowns (Sehri, Iftar, Tahajjud, Ishraq, forbidden times), Qibla compass, nearby mosques, essential daily amol, Quran, Hadith, Wisdom, Masnun duas and the 99 Names of Allah, habits, to-dos, Keep-style notes, a ledger (hisab khata), zikr counter, journal and home-screen widgets — with a 360° Nafs · Qalb · Ruh analytics dashboard. Free, works offline, data stays on your device. No ads.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
