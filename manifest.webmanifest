  "shortcuts": [
    {
      "name": "Prayer hub",
      "short_name": "Prayer",
      "description": "Prayer times with countdown, Qibla, mosques and essential amol",
      "url": "/?open=prayer&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Quran",
      "short_name": "Quran",
      "description": "Read the Holy Quran — Uthmani or Indo-Pak mushaf, offline",
      "url": "/?open=quran&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Reminder feed",
      "short_name": "Reminder",
      "description": "A verse, hadith, dua or wisdom to reflect on",
      "url": "/?open=reminder&source=shortcut",
