  "shortcuts": [
    {
      "name": "Quick check-in",
      "short_name": "Check-in",
      "description": "Tick today’s habits from a one-tap widget",
      "url": "/widgets/?view=habits&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Quick to-do",
      "short_name": "To-Do",
      "description": "Add or complete a to-do instantly",
      "url": "/widgets/?view=todo&add=1&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Zikr counter",
      "short_name": "Zikr",
      "description": "Open the digital tasbih",
      "url": "/?open=zikr&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New note",
      "short_name": "Note",
      "description": "Write a note, checklist or voice memo",
      "url": "/?open=notes&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Hisab khata",
      "short_name": "Ledger",
      "description": "Record dues, income and expenses",
      "url": "/?open=hisab&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Write in journal",
      "short_name": "Journal",
      "description": "Open today’s journal entry",
      "url": "/?source=note",
      "icons": [
        {
          "src": "/icons/shortcut.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Home",
      "short_name": "Home",
      "description": "Your 360° Muhasabah overview",
      "url": "/?tab=dashboard&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Prayer & Qibla",
      "short_name": "Qibla",
      "description": "Prayer times, Qibla compass and nearby mosques",
      "url": "/?open=prayer&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.shamimnoor.muhasabahpro",
      "id": "com.shamimnoor.muhasabahpro"
    },
    {
      "platform": "webapp",
      "url": "https://muhasabah-pro.app/manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "backup",
          "accept": [
            "application/json",
            ".json",
            "text/plain",
            ".txt"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/?source=file",
      "accept": {
        "application/json": [
          ".json"
        ],
        "text/plain": [
          ".txt"
        ]
      },
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+muhasabah",
      "url": "/?protocol=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 420
  },
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "note_taking": {
    "new_note_url": "/?source=note"
  },
  "scope_extensions": [
    {
      "type": "origin",
      "origin": "https://muhasabah-pro.netlify.app"
    }
  ],
  "widgets": [
    {
      "name": "Muhasabah — Today",
      "short_name": "Today",
      "description": "Today's habit progress, point balance and the next habit due.",
      "tag": "mhs-today",
      "template": "mhs-today",
      "ms_ac_template": "/widgets/today-template.json",
      "data": "/widgets/today-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshots/promo/20-widget.webp",
          "sizes": "1080x1920",
          "label": "Home-screen check-in widget"
        }
      ],
      "icons": [
        {
          "src": "/icons/icon-96.png",
          "sizes": "96x96"
        }
      ],
      "auth": false,
      "update": 3600
    }
  ]
}
