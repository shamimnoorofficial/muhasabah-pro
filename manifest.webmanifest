{
  "id": "/",
  "name": "Muhasabah Pro",
  "short_name": "Muhasabah",
  "description": "Muhasabah Pro is an Islamic life app for all ages: habits, to-dos, Google Keep-style notes, a ledger (hisab khata), zikr counter, daily amol & namaz guide, Quran, Hadith, prayer times and Qibla — with a 360° Nafs · Qalb · Ruh analytics dashboard. Free, works offline and keeps your data on your device. No ads.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "tab_strip": {
    "home_tab": {
      "scope_patterns": [
        {
          "pathname": "/"
        }
      ],
      "icons": [
        {
          "src": "/icons/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    "new_tab_button": {
      "url": "/?source=tabbed-new-tab"
    }
  },
  "orientation": "portrait",
  "background_color": "#0a0d14",
  "theme_color": "#0a0d14",
  "categories": [
    "lifestyle",
    "productivity",
    "education"
  ],
  "icons": [
    {
      "src": "/icons/icon-48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
